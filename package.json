    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:backfill": "tsx src/scripts/backfillHistory.ts",
    "db:studio": "drizzle-kit studio",
    "audit:api": "tsx src/scripts/auditEndpoints.ts",
    "audit:load": "tsx src/scripts/auditInitialLoad.ts",
    "audit:parity": "tsx src/scripts/auditParity.ts",
    "audit:flow": "tsx src/scripts/auditPaymentLinkFlow.ts",
    "audit:claim": "tsx src/scripts/auditPaymentLinkClaim.ts"
  },
