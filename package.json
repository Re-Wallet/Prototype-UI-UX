    "build": "vite build && rm -rf dist/landing && cp -r landing dist/landing",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/adapters/solana-pay.test.ts src/adapters/payment-verify.test.ts src/services/solanaHistory.test.ts src/services/webPaymentLink.test.ts src/services/survey.test.ts src/services/bugReport.test.ts",
